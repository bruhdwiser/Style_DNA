# ==============================================================================
# FlashFit Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001"]

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only service-role key (NEVER share with client applications)
# Used only by the backend for admin-authorized operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Supabase JWT Secret (Project Settings -> API -> JWT Settings)
# Used for local cryptographic signature validation of Supabase access tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OpenRouter AI Configuration (Optional for AI Chatbot)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# Site / Attribution URL
SITE_URL=http://localhost:5173
